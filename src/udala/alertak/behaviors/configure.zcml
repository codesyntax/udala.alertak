<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    i18n_domain="plone"
    >

  <include
      package="plone.behavior"
      file="meta.zcml"
      />

  <!-- -*- extra stuff goes here -*- -->

    <plone:behavior
        name="udala.alertak.alert"
        title="Alert"
        description="This behavior provides fields to show an alert on the frontpage of a site"
        provides=".alert.IAlert"
        factory=".alert.Alert"
        marker=".alert.IAlertMarker"
        />


</configure>
